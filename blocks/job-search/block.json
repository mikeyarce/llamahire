{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "llamahire/job-search",
  "version": "0.1.0",
  "title": "Job Search",
  "category": "widgets",
  "icon": "search",
  "description": "Search open roles by title or keyword.",
  "textdomain": "llamahire",
  "attributes": {
    "label": { "type": "string", "default": "Search jobs" },
    "placeholder": { "type": "string", "default": "Job title or keyword" },
    "buttonLabel": { "type": "string", "default": "Search" }
  },
  "supports": {
    "align": ["wide", "full"],
    "html": false,
    "interactivity": true,
    "color": { "text": true, "background": true },
    "spacing": { "margin": true, "padding": true },
    "typography": { "fontSize": true, "lineHeight": true },
    "border": { "color": true, "radius": true, "style": true, "width": true }
  },
  "editorScript": "llamahire-blocks-editor",
  "style": "llamahire",
  "viewScriptModule": "llamahire-job-discovery"
}
