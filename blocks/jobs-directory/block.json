{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "llamahire/jobs-directory",
  "version": "0.1.0",
  "title": "Jobs Directory",
  "category": "widgets",
  "icon": "businessperson",
  "description": "Display searchable, filterable open roles.",
  "textdomain": "llamahire",
  "attributes": {
    "perPage": { "type": "number", "default": 12 },
    "showFilters": { "type": "boolean", "default": true },
    "featuredOnly": { "type": "boolean", "default": false },
    "department": { "type": "string", "default": "" }
  },
  "supports": {
    "align": ["wide", "full"],
    "html": false,
    "interactivity": true,
    "color": { "text": true, "background": true, "link": true },
    "spacing": { "margin": true, "padding": true, "blockGap": true },
    "typography": { "fontSize": true, "lineHeight": true },
    "border": { "color": true, "radius": true, "style": true, "width": true }
  },
  "editorScript": "llamahire-blocks-editor",
  "style": "llamahire",
  "viewScriptModule": "llamahire-job-discovery"
}
